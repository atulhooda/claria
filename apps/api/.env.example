# ---------- App ----------
APP_ENV=development                           # development | staging | production
LOG_LEVEL=INFO                                # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
# Default points at the local docker-compose Postgres (see repo root).
# For Neon, replace with the asyncpg connection string from your branch.
#
# First-time setup:
#   docker compose -f docker-compose.dev.yml up -d   (from repo root)
#   cd apps/api && uv run alembic upgrade head       (runs migrations)
DATABASE_URL=postgresql+asyncpg://claria:claria_dev@localhost:5432/claria_dev

# ---------- Auth (Clerk) ----------
# Issuer URL from the Clerk dashboard → API Keys → "Show JWT public key".
# Development looks like https://<slug>.clerk.accounts.dev
# Production looks like https://clerk.<your-domain>
CLERK_JWT_ISSUER=https://example.clerk.accounts.dev

# Optional comma-separated allow-list of `azp` (authorized party) values —
# the URLs Clerk is configured to issue tokens to (e.g. your web origin).
# Leave empty to skip azp validation.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# JWKS cache TTL in seconds. Default 3600. Lower if you rotate keys often.
# CLERK_JWKS_TTL_SECONDS=3600

# ---------- Auth bypass (dev only) ----------
# Mirror of the web app's NEXT_PUBLIC_AUTH_BYPASS. When "true", every
# request (HTTP or WebSocket) is treated as `user_dev_bypass` without
# Clerk validation. Hard-disabled in production regardless of value.
# AUTH_BYPASS=true

# ---------- STT (Deepgram) ----------
# API key from https://console.deepgram.com → Settings → API Keys
# Required for the consultation WebSocket. Without it the endpoint
# returns a 4503 close code.
# DEEPGRAM_API_KEY=

# Multilingual defaults (recommended for Indian clinical workflows):
# `nova-3` general model + `multi` language enables real Hindi+English
# code-switching (Hinglish) transcription. The LLM downstream
# normalizes outputs to clinical English regardless of input language.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi
#
# English-only deployment alternative (slightly better medical-term accuracy):
# DEEPGRAM_MODEL=nova-3-medical
# DEEPGRAM_LANGUAGE=en-US

# ---------- AI clinical pipeline (OpenAI) ----------
# Without this key the WebSocket still streams transcripts, but the
# SOAP / extractions / summary pipelines stay silent.
# OPENAI_API_KEY=

# Optional model overrides.
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_CAPABLE=gpt-4o

# Optional pipeline cadence tuning (defaults shown).
# AI_EXTRACTION_INTERVAL_SEC=12
# AI_EXTRACTION_MIN_NEW_LINES=1
# AI_SOAP_INTERVAL_SEC=30
# AI_SOAP_MIN_NEW_LINES=3
# AI_SUMMARY_INTERVAL_SEC=60

# ---------- Observability (optional) ----------
# SENTRY_DSN=
