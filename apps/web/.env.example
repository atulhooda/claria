# ---------- App ----------
NEXT_PUBLIC_APP_ENV=development                # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- API ----------
# Public base URL used by the browser. Must include the /api/v1 prefix
# exactly once — the fetch client appends paths relative to this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional server-only override used by RSC fetches (e.g. talking to the
# API over an internal hostname in production). Falls back to the public URL.
# API_BASE_URL_INTERNAL=http://api:8000/api/v1

# ---------- Auth (Clerk) ----------
# Temporary dev-only bypass: when "true", `next.config.mjs` aliases
# `@clerk/nextjs` and `@clerk/nextjs/server` to local mocks in
# `src/lib/dev-auth/`. The app renders as if a user is signed in,
# letting you inspect the UI without real Clerk keys.
# Leave unset (or "false") in staging/production.
# NEXT_PUBLIC_AUTH_BYPASS=true

# Publishable key — safe in the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Secret key — server-only. Never expose to the browser.
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk redirects on sign-in / sign-up / sign-out / first sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
