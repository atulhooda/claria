# Strict pnpm workspace settings.
#
# - shamefully-hoist=false (default) keeps each package's node_modules clean:
#   only declared dependencies are visible to that package, so import errors
#   surface in CI instead of leaking in via accidental hoisting.
# - link-workspace-packages=true lets `packages/*` resolve siblings by name
#   (used once @claria/shared-types lands).
# - prefer-workspace-packages=true forces siblings to resolve from the
#   workspace rather than the registry.
# - auto-install-peers=true installs declared peer deps automatically so
#   the IDE's resolver doesn't trip on missing-peer warnings.

link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
strict-peer-dependencies=false
